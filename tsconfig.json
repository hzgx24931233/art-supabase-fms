{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "vite/client", "element-plus/global"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@fms/*": ["src/*"],
      "@/*": ["node_modules/art-supabase-pro/src/*", "../art-supabase-pro/src/*", "../../src/*"],
      "@views/*": [
        "node_modules/art-supabase-pro/src/views/*",
        "../art-supabase-pro/src/views/*",
        "../../src/views/*"
      ],
      "@styles/*": [
        "node_modules/art-supabase-pro/src/assets/styles/*",
        "../art-supabase-pro/src/assets/styles/*",
        "../../src/assets/styles/*"
      ],
      "@utils/*": [
        "node_modules/art-supabase-pro/src/utils/*",
        "../art-supabase-pro/src/utils/*",
        "../../src/utils/*"
      ],
      "@stores/*": [
        "node_modules/art-supabase-pro/src/store/*",
        "../art-supabase-pro/src/store/*",
        "../../src/store/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "src/**/*",
    "tests/unit/**/*.ts",
    "node_modules/art-supabase-pro/src/types/**/*.d.ts"
  ],
  "exclude": []
}
